# ═══════════════════════════════════════════════════════════
# SentraEdu — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
# The app auto-detects the driver based on DATABASE_URL:
#   - Local PostgreSQL (localhost/127.0.0.1) → uses `pg` (TCP)
#   - Neon PostgreSQL (.neon.tech)           → uses `neon` (HTTP)
#
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/sentra_edu
#
# Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:password@ep-xxx-region.aws.neon.tech/sentra_edu?sslmode=require

# ── Admin Account ─────────────────────────────────────────
# Used on first startup to create the admin user
ADMIN_EMAIL=super@admin.com
ADMIN_PASSWORD=superadmin123
